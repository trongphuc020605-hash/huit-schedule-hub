{
    "name": "huit/schedule-hub",
    "description": "HUIT Schedule Hub - Multi-Campus Intelligent Teaching Schedule Management & Optimization System",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "huit",
        "scheduling",
        "timetable",
        "multi-campus",
        "edtech",
        "php",
        "mysql",
        "optimization"
    ],
    "authors": [
        {
            "name": "HUIT Schedule Hub Contributors"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "vlucas/phpdotenv": "^5.6",
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "HuitSchedule\\": "src/"
        }
    },
    "scripts": {
        "doctor": "php scripts/doctor.php",
        "test:unit": "php tests/unit_tests.php",
        "test:integration": "php tests/integration_verify.php",
        "seed": "php database/seed.php",
        "seed:fresh": "php database/seed.php --fresh"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
